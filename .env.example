# Adres projektu Supabase (Project Settings -> API). Jest publiczny.
NEXT_PUBLIC_SUPABASE_URL=https://TWOJ-PROJEKT.supabase.co
# Klucz publishable (sb_publishable_...), dawniej anon. Jest przeznaczony do przeglądarki.
# NIGDY nie wpisuj tu klucza sb_secret_... (dawniej service_role).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

